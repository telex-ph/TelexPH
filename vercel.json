{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "telexph.com" }],
      "destination": "https://www.telexph.com/$1",
      "permanent": true
    },
    {
      "source": "/careers/job-details",
      "has": [{ "type": "query", "key": "job", "value": "(?<job>[a-z-]+)" }],
      "destination": "/careers/job-details/:job",
      "permanent": true
    },
    { "source": "/resources/Blogs", "destination": "/resources/blogs", "permanent": true },
    { "source": "/call-center-in-the-philippines", "destination": "/customer-service-outsourcing-philippines", "permanent": true },
    { "source": "/telex-business-support-services-inc{/}?", "destination": "/about", "permanent": true },
    { "source": "/contact-us{/}?", "destination": "/contact", "permanent": true },
    { "source": "/about-us{/}?", "destination": "/about", "permanent": true },
    { "source": "/blog{/}?", "destination": "/resources/blogs", "permanent": true },
    { "source": "/service{/}?", "destination": "/services", "permanent": true },
    { "source": "/social-media-management{/}?", "destination": "/services", "permanent": true },
    { "source": "/resources/blogs/mastering-business-growth-a-beginners-guide-to-outsourcing-101{/}?", "destination": "/resources/blogs/business-growth-strategy", "permanent": true },
    { "source": "/resources/blogs/the-healthcare-bpo-revolution-a-comprehensive-guide-to-scaling-patient-centric-medical-operations-in-the-modern-era{/}?", "destination": "/resources/blogs/business-growth-strategy", "permanent": true },
    { "source": "/resources/blogs/outsourcing-101-the-founders-guide-to-operational-freedom{/}?", "destination": "/resources/blogs/business-growth-strategy", "permanent": true },
    { "source": "/resources/blogs/unlocking-cx-excellence-the-future-of-customer-service{/}?", "destination": "/resources/blogs/business-growth-strategy", "permanent": true }
  ],
  "rewrites": [
    { "source": "/admin/:path*", "destination": "/app.html" },
    { "source": "/client/:path*", "destination": "/app.html" },
    { "source": "/VirtualAssistant/:path*", "destination": "/app.html" },
    { "source": "/VAdash/:path*", "destination": "/app.html" },
    { "source": "/funnels/:path*", "destination": "/app.html" },
    { "source": "/careers/job-details/:job", "destination": "/app.html" },
    { "source": "/resources/blogs/:slug", "destination": "/app.html" },
    { "source": "/resources/case-studies/:slug", "destination": "/app.html" },
    { "source": "/resources/IndustryUseCase", "destination": "/app.html" },
    { "source": "/resources/CaseStudiesCardDetails", "destination": "/app.html" },
    { "source": "/resources/casestudiescarddetails", "destination": "/app.html" },
    { "source": "/Apply", "destination": "/app.html" },
    { "source": "/logistics/:page(privacy|terms|landing)", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.google.com https://www.gstatic.com https://widgets.leadconnectorhq.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://res.cloudinary.com https://images.unsplash.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://app.telexph.com https://widgets.leadconnectorhq.com https://challenges.cloudflare.com; frame-src 'self' https://www.google.com https://challenges.cloudflare.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ]
}
 